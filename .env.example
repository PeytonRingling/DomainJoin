# ── Runtime (docker run / docker compose up) ────────────────────────────────
# The port Express listens on inside the container.
PORT=3001

# The UPN suffix appended to new usernames (e.g. jsmith@corp.example.com).
UPN_SUFFIX=corp.example.com

# ── Build-time only (docker compose build / docker build --build-arg) ────────
# These are baked into the React bundle by Vite. Changing them after build has no effect.
# Set them before running `docker compose build`, not `docker compose up`.
VITE_DEFAULT_DC=10.0.0.10
VITE_DEFAULT_OU=OU=Users,OU=Corp,DC=corp,DC=example,DC=com
