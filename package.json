{
  "name": "domain-user-app",
  "productName": "DomainUserProvisioner",
  "version": "1.0.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "server": "node server/index.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.292.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.3",
    "concurrently": "^9.2.1",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "vite": "^5.0.8"
  },
  "build": {
    "appId": "com.example.domainuserapp",
    "win": {
      "target": "portable",
      "icon": "public/vite.svg"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "main.js",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  }
}
